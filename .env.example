# Copy to .env and fill in. Vite bakes these into the build, so for Docker
# pass them as build args (see Dockerfile) — changing them needs a rebuild.

# Backend API used by logged-in pages
VITE_API_BASE_URL=http://localhost:8090/api/v1
# Backend origin for public (no-login) calls: apply form, resume links
VITE_PUBLIC_API_URL=http://localhost:8090

# Tests only: a real JWT so src/tests/api/* can hit the backend
# (get one from POST /api/v1/auth/login)
# VITE_TEST_TOKEN=
